{
  "manifest_version": 3,
  "name": "Kwork — скрытие проектов",
  "version": "1.20.1",
  "description": "Скрывает ненужные проекты на бирже Kwork, извлекает данные заказов, показывает ближайшую выплату и сохраняет переписки с клиентами на диск.",
  "permissions": [
    "storage",
    "nativeMessaging",
    "tabs",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "https://kwork.ru/*",
    "https://cdn-edge.kwork.ru/*",
    "https://kwork-conversation.storage.yandexcloud.net/*",
    "https://kwork-track.storage.yandexcloud.net/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Переписки Kwork"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kwork.ru/*"
      ],
      "js": [
        "src/core.js",
        "src/feed-main.js",
        "src/inbox-core.js",
        "src/inbox-main.js",
        "src/inbox-crawler.js",
        "src/ticks-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://kwork.ru/*"
      ],
      "js": [
        "src/core-isolated.js",
        "src/inbox-core-isolated.js",
        "src/project-core.js",
        "src/payout-core.js",
        "src/payout-source.js",
        "src/content.js",
        "src/feed-content.js",
        "src/inbox-content.js",
        "src/project-content.js",
        "src/payout-content.js",
        "src/report-toggle.js",
      "src/ticks-content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": ""
}
